# LLM (local Ollama via its OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_DISABLE_THINKING=false
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096

# Agent
AGENT_MAX_STEPS=5

# Existing ML lead-scoring service (blank = use mock scorer)
ML_SCORING_URL=

# Indicative credit parameters (replace with credit policy values)
DEFAULT_ROI=9.5
FOIR_CAP=0.50